{
  "manifest_version": 3,
  "name": "Artikelsuche im Katalog",
  "version": "1.1.0",
  "description": "Die Artikelsuche als Kompaktfenster öffnen und markierten Text im Firmenkatalog suchen.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "sidePanel", "storage"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Artikelsuche öffnen"},
  "side_panel": {"default_path": "panel.html"}
}
